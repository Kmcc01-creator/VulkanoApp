// UI Configuration Example
(
    text: (
        default_font: "Roboto",
        font_size: 16.0,
        line_height: 1.2,
        letter_spacing: 0.0,
        sdf_settings: (
            smoothing: 0.125,
            thickness: 0.5,
            padding: 4.0,
        ),
    ),
    layout: (
        padding: (
            top: 5.0,
            right: 5.0,
            bottom: 5.0,
            left: 5.0,
        ),
        spacing: (
            horizontal: 10.0,
            vertical: 10.0,
        ),
        alignment: Left,
    ),
    themes: {
        "default": (
            colors: {
                "text": [1.0, 1.0, 1.0, 1.0],
                "background": [0.1, 0.1, 0.1, 1.0],
                "primary": [0.2, 0.6, 1.0, 1.0],
                "secondary": [0.5, 0.5, 0.5, 1.0],
                "accent": [1.0, 0.6, 0.2, 1.0],
            },
            fonts: {
                "regular": "Roboto-Regular",
                "bold": "Roboto-Bold",
                "italic": "Roboto-Italic",
            },
        ),
        "light": (
            colors: {
                "text": [0.1, 0.1, 0.1, 1.0],
                "background": [0.95, 0.95, 0.95, 1.0],
                "primary": [0.2, 0.5, 0.9, 1.0],
                "secondary": [0.6, 0.6, 0.6, 1.0],
                "accent": [0.9, 0.5, 0.1, 1.0],
            },
            fonts: {
                "regular": "Roboto-Regular",
                "bold": "Roboto-Bold",
                "italic": "Roboto-Italic",
            },
        ),
    },
    active_theme: "default",
)